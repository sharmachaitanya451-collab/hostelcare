# =============================================================================
# HostelCare Backend Environment Variables
# =============================================================================
# NEVER commit this file to version control.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-strong-random-secret-key

# Database Connections (PostgreSQL 18 via psycopg 3: postgresql+psycopg://...)
# Note: If passwords contain special URL characters (e.g. @, :, /, #, %, ?),
# percent-encode them (e.g., '@' becomes '%40', ':' becomes '%3A')
# or use individual components in connection helpers if needed.

# Application Runtime Role (hostelcare_app - strictly DML only on application tables)
DATABASE_URL=postgresql+psycopg://hostelcare_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/hostelcare

# Migration Role (hostelcare_owner - used by Flask-Migrate / Alembic for schema DDL)
MIGRATION_DATABASE_URL=postgresql+psycopg://hostelcare_owner:REPLACE_WITH_OWNER_PASSWORD@localhost:5432/hostelcare

# Test Database Connections (used by automated test suite)
TEST_DATABASE_URL=postgresql+psycopg://hostelcare_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/hostelcare_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://hostelcare_owner:REPLACE_WITH_OWNER_PASSWORD@localhost:5432/hostelcare_test

# Configurable hostel placeholders
HOSTEL_NAME=Your Hostel Name
HOSTEL_BLOCKS=A,B,C
HOSTEL_ROOM_PATTERN=^[0-9]{3}$
LOG_LEVEL=INFO

# Single-service production frontend & reverse-proxy settings
SERVE_FRONTEND=false
PROXY_FIX_ENABLED=false
TRUSTED_PROXY_COUNT=1

# Optional role names for managed PostgreSQL migrations (defaults match local setup)
DB_MIGRATION_ROLE=hostelcare_owner
DB_APP_ROLE=hostelcare_app

# Session & Cookie Security
SESSION_COOKIE_NAME=hostelcare_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# Provider-Independent Email Configuration (console | smtp | disabled)
# Use console for local testing, or set smtp for real Gmail delivery with an App Password:
#   MAIL_BACKEND=smtp
#   MAIL_FROM=HostelCare <your-gmail-account@gmail.com>
#   MAIL_SMTP_HOST=smtp.gmail.com
#   MAIL_SMTP_PORT=587
#   MAIL_SMTP_USERNAME=your-gmail-account@gmail.com
#   MAIL_SMTP_PASSWORD=replace-with-16-char-gmail-app-password
#   MAIL_USE_TLS=true
MAIL_BACKEND=console
MAIL_FROM=no-reply@hostelcare.local
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_USE_TLS=true
MAIL_TIMEOUT_SECONDS=10

# Razorpay Online Payments (Test Mode Only — never commit live secrets)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_with_test_key
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_test_webhook_secret

# Complaint Attachment Storage (local | r2)
# Local development defaults to private filesystem storage (`local`).
# Set COMPLAINT_ATTACHMENT_STORAGE_BACKEND=r2 in production (Render) with a private R2 bucket.
COMPLAINT_ATTACHMENT_STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_REGION=auto
R2_CONNECT_TIMEOUT_SECONDS=5
R2_READ_TIMEOUT_SECONDS=15
