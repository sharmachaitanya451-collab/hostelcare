# Copy to .env (never commit .env). Values here are placeholders.
FLASK_ENV=development
SECRET_KEY=change-me-in-real-environments
# PostgreSQL via psycopg 3. Leave unset until the app database and role exist.
# DATABASE_URL=postgresql+psycopg://hostelcare_app:PASSWORD@localhost:5432/hostelcare
# TEST_DATABASE_URL=postgresql+psycopg://hostelcare_app:PASSWORD@localhost:5432/hostelcare_test

# Configurable hostel placeholders
HOSTEL_NAME=Your Hostel Name
# Comma-separated block names; empty means no blocks
HOSTEL_BLOCKS=A,B,C
# Room number pattern (regex) used later to validate room entries
HOSTEL_ROOM_PATTERN=^[0-9]{3}$
LOG_LEVEL=INFO
